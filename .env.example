# Docker Compose environment (root .env) — see backend/.env.example for full backend options

# Database
DATABASE_URL=sqlite:///./switches.db
# For PostgreSQL: DATABASE_URL=postgresql://user:pass@postgres:5432/hermes

# OpenAI / AI
OPENAI_API_KEY=sk-your-key-here

# SSH Credentials (default for network devices)
SSH_USERNAME=admin
SSH_PASSWORD=your-password

# Logging
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend -> Backend API base URL
NEXT_PUBLIC_API_URL=http://localhost:8000
