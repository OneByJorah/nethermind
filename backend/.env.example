# Database
DATABASE_URL=sqlite:///./switches.db
# For PostgreSQL: DATABASE_URL=postgresql://user:pass@localhost:5432/nethermind

# OpenAI / AI
OPENAI_API_KEY=<set-value>
OPENAI_MODEL=gpt-4o

# SSH Credentials (default for network devices)
SSH_USERNAME=admin
SSH_PASSWORD=<set-value>
SSH_TIMEOUT=30

# Security
SECRET_KEY=<set-value>

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Containerlab
CLAB_DIR=/etc/containerlab/lab

# Logging
LOG_LEVEL=INFO
